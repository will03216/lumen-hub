# Clerk Auth (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# Key encryption (generate with: openssl rand -hex 32)
KEY_ENCRYPTION_SECRET=

# PostgreSQL — BytePlus RDS (production) or Supabase direct connection (dev)
# BytePlus RDS:  postgres://user:pass@<internal-ip>:5432/lumenhub
# Supabase dev:  postgres://postgres:[password]@db.<project>.supabase.co:5432/postgres
DATABASE_URL=


# =============================================================================
# REQUIRED
# =============================================================================

# BytePlus / Ark API key — get yours at https://console.byteplus.com
# ARK_API_KEY is accepted as a fallback alias for the same key.
BYTEPLUS_API_KEY=your-byteplus-api-key-here


# =============================================================================
# BYTEPLUS MODEL OVERRIDES (optional — defaults shown)
# =============================================================================

# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# BYTEPLUS_IMAGE_MODEL=seedream-5-0-lite-260128
# BYTEPLUS_VIDEO_MODEL=seedance-1-5-pro-251215
# BYTEPLUS_CAPTION_MODEL=seed-2-0-lite-260228
# BYTEPLUS_PROMPT_MODEL=seed-2-0-pro-260228

# Map logical model IDs to BytePlus inference endpoint IDs (ep-...).
# Required only when your account provisions models via console endpoints
# instead of raw model IDs.
# Format: logical1=ep-...,logical2=ep-...
# BYTEPLUS_MODEL_ALIASES=


# =============================================================================
# MODELARK ASSET LIBRARY (optional — enables the Library panel cloud sync)
# =============================================================================

# BytePlus Access Key and Secret Key (from IAM console)
# MODELARK_AK=your-access-key
# MODELARK_SK=your-secret-key

# TOS bucket name (must have public-read policy)
# MODELARK_TOS_BUCKET=your-bucket-name

# Override defaults only if your account is in a different region/version
# MODELARK_HOST=open.byteplusapi.com
# MODELARK_REGION=ap-southeast-1
# MODELARK_SERVICE=ark
# MODELARK_VERSION=2024-01-01
# MODELARK_TOS_REGION=cn-beijing
# MODELARK_TOS_HOST=tos-ap-southeast-1.bytepluses.com


# =============================================================================
# MINIMAX (optional — enables Hailuo / T2V-01-Director video models)
# =============================================================================

# Get your key and Group ID at https://platform.minimax.io
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_GROUP_ID=your-minimax-group-id
# MINIMAX_BASE_URL=https://api.minimax.io/v1


# =============================================================================
# FAL.AI (optional — enables GPT Image 2 and other fal-hosted models)
# =============================================================================

# Get your key at https://fal.ai/dashboard/keys
# Format: <key_id>:<key_secret>
# FAL_API_KEY=your-fal-key-id:your-fal-key-secret


# (Supabase removed — auth is handled by Clerk, DB by BytePlus RDS)
