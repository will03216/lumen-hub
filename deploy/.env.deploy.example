CR_REGISTRY=lumen-ap-southeast-3.cr.bytepluses.com
CR_USER=mittul.madaan@78638713
CR_PASSWORD=
IMAGE_TAG=latest

# --- Build-time NEXT_PUBLIC_* (baked into the client bundle) ---
