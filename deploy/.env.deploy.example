# Copy to deploy/.env.deploy and fill in. This file is git-ignored.
# Used by build-push.sh and deploy.sh. Holds NON-app deploy config + CR creds.

# --- Container Registry ---
REGISTRY=your-region.cr.bytepluses.com/your-namespace
CR_REGISTRY=your-region.cr.bytepluses.com
CR_USER=your-cr-username@your-account-id
CR_PASSWORD=
IMAGE_TAG=latest

# --- Build-time NEXT_PUBLIC_* (baked into the client bundle) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=https://your-app-domain.com
NEXT_PUBLIC_CDN_BASE=

# --- ECS target ---
ECS_HOST=ubuntu@REPLACE_WITH_ECS_PUBLIC_IP
SSH_KEY=~/.ssh/id_rsa
REMOTE_DIR=/opt/lumen-hub
