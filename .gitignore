# Dependencies
node_modules/

# Local debug snapshots
debug/

# Next.js build output
.next/
out/

# TypeScript incremental build cache
*.tsbuildinfo

# Next.js auto-generated type file (references .next/ internals)
next-env.d.ts

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.production
.env.test.local
.env.production.local

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime-generated media cache (populated at runtime, not source-controlled)
public/library-cache/

# Misc
.vercel

# clerk configuration (can include secrets)
/.clerk/

# deploy config (CR creds, build vars)
deploy/.env.deploy

# Local dev artifacts — not for source control
.venv/
tmp/
output/
.claude/
temp/
