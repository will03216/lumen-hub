# Copy this to .env.production on the ECS instance and fill in all values.
# Never commit .env.production to git.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Clerk (get from dashboard.clerk.com → API Keys, use live keys not test)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# IMPORTANT — Clerk one-time dashboard step (required for the forced-setup gate
# AND the access allowlist below):
#   Dashboard → Sessions → "Customize session token" → add:
#     { "metadata": "{{user.public_metadata}}", "email": "{{user.primary_email_address}}" }
#   Without `metadata`, new users loop on /settings.
#   Without `email`, the access allowlist (if enabled) fail-closes and denies everyone.

# Access gate (optional, defense-in-depth on top of Clerk Restrictions).
# Two ways in, checked together:
#   1) Coarse env allowlist below — internal staff by domain + specific emails.
#      Read at process start: update + restart, no rebuild.
#   2) Per-user grant in Clerk — set { "approved": true } on the user's public
#      metadata. Read per-request from the session token: instant, no restart.
# The gate is ON if either list below is non-empty OR REQUIRE_APPROVAL is set.
# Set REQUIRE_APPROVAL=true to gate purely on Clerk approvals (empty lists) —
# flip on once, then manage every grant from the Clerk dashboard, no redeploys.
# Leave all three unset to allow any authenticated user (gate off, fail-open).
ALLOWED_EMAIL_DOMAINS=bytedance.com
ALLOWED_EMAILS=
# e.g. ALLOWED_EMAILS=alice@customer.com,bob@partner.io
REQUIRE_APPROVAL=

# PostgreSQL — BytePlus RDS internal VPC address
DATABASE_URL=postgres://user:pass@10.x.x.x:5432/lumenhub?sslmode=require

# Key encryption — generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# STRICT BYOK — do NOT set provider/credential keys here.
#
# Every user supplies their own keys via /settings (encrypted per-user in the
# DB). There is no env fallback: if the deploy sets these, they are simply
# ignored by the app. Listed here only so nobody re-adds them by habit.
#   BYTEPLUS_API_KEY / ARK_API_KEY   → per user (byteplus)
#   MODELARK_AK / MODELARK_SK        → per user (byteplus_ak / byteplus_sk)
#   MODELARK_TOS_BUCKET              → per user (byteplus_tos_bucket)
#   MINIMAX_API_KEY / MINIMAX_GROUP_ID → per user (optional provider)
#   FAL_API_KEY                      → per user (optional provider)
# ──────────────────────────────────────────────────────────────────────────

# ModelArk shared INFRA config (not credentials) — safe to set platform-wide.
# Defaults are baked in; override only if your region/host differ.
# MODELARK_HOST=open.byteplusapi.com
# MODELARK_REGION=ap-southeast-1
# MODELARK_TOS_REGION=cn-beijing
# MODELARK_TOS_HOST=

# CDN base URL (BytePlus CDN endpoint in front of TOS)
NEXT_PUBLIC_CDN_BASE=https://cdn.yourdomain.com

# ── Image editor (/edit) ──────────────────────────────────────────────────
#
# The language model behind the editor's agent and its "Enhance" button.
# Pinned in code to Seed 2.0 Pro; set this only if the account does not have
# Pro enabled, in which case the agent fails with a 404/403 rather than
# silently falling back.
#   BYTEPLUS_EDIT_MODEL=seed-2-0-pro-260328
#
# Layer separation (§5B) is a BytePlus preview feature and is granted per
# account. It is ON by default and degrades to a clear message when a key
# lacks access, so there is normally nothing to set. The kill switch is
# NEXT_PUBLIC_EDIT_LAYERS=0 — and because NEXT_PUBLIC_* is inlined into the
# client bundle at BUILD time, it must be passed to `docker buildx build` as
# a --build-arg. Setting it here does nothing.
