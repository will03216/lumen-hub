# Copy this to .env.production on the ECS instance and fill in all values.
# Never commit .env.production to git.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Clerk (get from dashboard.clerk.com → API Keys, use live keys not test)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# PostgreSQL — BytePlus RDS internal VPC address
DATABASE_URL=postgres://user:pass@10.x.x.x:5432/lumenhub

# Key encryption — generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# BytePlus AI (platform fallback — users can override with their own keys)
BYTEPLUS_API_KEY=

# BytePlus TOS asset storage
MODELARK_AK=
MODELARK_SK=
MODELARK_TOS_BUCKET=
MODELARK_TOS_REGION=

# CDN base URL (BytePlus CDN endpoint in front of TOS)
NEXT_PUBLIC_CDN_BASE=https://cdn.yourdomain.com

# Optional providers (users can supply their own keys via /settings)
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# FAL_API_KEY=
