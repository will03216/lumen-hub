# Copy this to .env.production on the ECS instance and fill in all values.
# Never commit .env.production to git.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Clerk (get from dashboard.clerk.com → API Keys, use live keys not test)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# IMPORTANT — Clerk one-time dashboard step (required for the forced-setup gate
# AND the access allowlist below):
#   Dashboard → Sessions → "Customize session token" → add:
#     { "metadata": "{{user.public_metadata}}", "email": "{{user.primary_email_address}}" }
#   Without `metadata`, new users loop on /settings.
#   Without `email`, the access allowlist (if enabled) fail-closes and denies everyone.

# Access allowlist (optional, defense-in-depth on top of Clerk Restrictions).
# Limit the platform to internal staff by domain + specific customer emails.
# Leave BOTH unset to allow any authenticated user. When EITHER is set the gate
# is enforced (fail-closed). Read at runtime — update + restart, no rebuild.
ALLOWED_EMAIL_DOMAINS=bytedance.com
ALLOWED_EMAILS=
# e.g. ALLOWED_EMAILS=alice@customer.com,bob@partner.io

# PostgreSQL — BytePlus RDS internal VPC address
DATABASE_URL=postgres://user:pass@10.x.x.x:5432/lumenhub?sslmode=require

# Key encryption — generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# STRICT BYOK — do NOT set provider/credential keys here.
#
# Every user supplies their own keys via /settings (encrypted per-user in the
# DB). There is no env fallback: if the deploy sets these, they are simply
# ignored by the app. Listed here only so nobody re-adds them by habit.
#   BYTEPLUS_API_KEY / ARK_API_KEY   → per user (byteplus)
#   MODELARK_AK / MODELARK_SK        → per user (byteplus_ak / byteplus_sk)
#   MODELARK_TOS_BUCKET              → per user (byteplus_tos_bucket)
#   MINIMAX_API_KEY / MINIMAX_GROUP_ID → per user (optional provider)
#   FAL_API_KEY                      → per user (optional provider)
# ──────────────────────────────────────────────────────────────────────────

# ModelArk shared INFRA config (not credentials) — safe to set platform-wide.
# Defaults are baked in; override only if your region/host differ.
# MODELARK_HOST=open.byteplusapi.com
# MODELARK_REGION=ap-southeast-1
# MODELARK_TOS_REGION=cn-beijing
# MODELARK_TOS_HOST=

# CDN base URL (BytePlus CDN endpoint in front of TOS)
NEXT_PUBLIC_CDN_BASE=https://cdn.yourdomain.com
